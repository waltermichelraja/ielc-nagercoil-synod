# ── Set these as Environment Variables on the ADMIN Netlify site ──
# (Site settings → Environment variables). Do NOT commit real values.
# These are read by the serverless functions in netlify/functions/, never
# by the browser bundle, so they stay secret.

# A fine-grained GitHub Personal Access Token, scoped to ONLY this repo,
# with "Contents: Read and write" permission. Nothing else.
GITHUB_TOKEN=

# Repo owner (GitHub username or org)
GITHUB_OWNER=waltermichelraja

# Repo name
GITHUB_REPO=ielc-nagercoil-synod

# Branch the admin app reads from and writes to
GITHUB_BRANCH=v1-react

# ── This one is safe to expose to the browser (must be prefixed VITE_) ──
# Used only to preview existing images (which live on the public frontend
# site) inside the admin forms. Point it at your live frontend site URL.
VITE_FRONTEND_URL=https://ielcnagercoilsynod.com
